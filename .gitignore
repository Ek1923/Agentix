# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Secrets — never commit
.env
.env.*
!.env.example

# Native build artefacts. Regenerated by `cap sync`, so committing them means
# merge conflicts in files nobody edits.
agentix-android/android/app/src/main/assets/public
agentix-android/android/app/build
agentix-android/android/build
agentix-android/android/.gradle
agentix-android/android/local.properties
agentix-android/android/capacitor-cordova-android-plugins
agentix-ios/ios/App/App/public
agentix-ios/ios/App/App/capacitor.config.json
agentix-ios/ios/App/build
agentix-ios/ios/App/Pods
agentix-ios/ios/.build
DerivedData
xcuserdata

# Signing material never belongs in a repository.
*.keystore
*.jks
*.p12
*.mobileprovision
*.cer
keystore.properties

# This machine's own tool permissions, not project configuration. `.claude/`
# itself is shared on purpose; the `.local.json` inside it never is.
.claude/settings.local.json

# Editor and OS noise
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.log

# Generated knowledge graph. 3.3 MB of derived output that is rebuilt from the
# source it describes, so committing it only ages badly.
graphify-out

# The owner's private server runbook. Describes personal infrastructure — the
# Ubuntu box, the tunnel, the deploy path — so it stays out of a repo that may go
# public. It is a working note for one person, not project documentation.
SERVER-SETUP.md
