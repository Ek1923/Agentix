# Copy to server/.env on the box and fill in. server/.env is gitignored — it never
# leaves the machine. Generate each secret with:  openssl rand -base64 32

# Postgres superuser for the agentix database (also used by Keycloak).
DB_PASSWORD=

# The role PostgREST logs in as. Set the same value on the `authenticator` role:
#   alter role authenticator login password '<this>';
AUTHENTICATOR_PASSWORD=

# Keycloak admin console login.
KEYCLOAK_ADMIN_PASSWORD=

# The public https origin the tunnel serves, e.g. https://id.example.com
PUBLIC_URL=

# Cloudflare Tunnel token, from the Zero Trust dashboard.
TUNNEL_TOKEN=

# Keycloak's realm JWKS as a single-line JSON, for PostgREST to validate tokens.
# Left blank until Keycloak is up; the deploy workflow fills it in. To set by hand:
#   curl -s $PUBLIC_URL/realms/agentix/protocol/openid-connect/certs | jq -c .
JWKS_JSON=
